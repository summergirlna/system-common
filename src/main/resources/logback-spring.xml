<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR" value="${SYSTEM_COMMON_LOG_DIR:-logs}"/>
    <property name="APP_NAME" value="system-common"/>

    <property
            name="FILE_LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <append>true</append>

        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="com.example.systemcommon" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

</configuration>